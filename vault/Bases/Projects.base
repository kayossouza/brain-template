filters:
  and:
    - file.inFolder("Projects")
    - file.ext == "md"

formulas:
  days_since_edit: '(now() - file.mtime).days'
  linked_from: 'file.backlinks.length'

properties:
  file.name:
    displayName: "Project"
  file.folder:
    displayName: "Folder"
  formula.days_since_edit:
    displayName: "Days since edit"
  formula.linked_from:
    displayName: "Linked from (notes)"
  tags:
    displayName: "Tags"

views:
  - type: table
    name: "All"
    order:
      - file.name
      - file.folder
      - formula.linked_from
      - formula.days_since_edit
      - tags
    sort:
      - property: formula.days_since_edit
        direction: ASC
  - type: table
    name: "Untouched for 30+ days"
    filters: 'formula.days_since_edit > 30'
    order:
      - file.name
      - file.folder
      - formula.days_since_edit
    sort:
      - property: formula.days_since_edit
        direction: DESC
