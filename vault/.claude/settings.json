{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(date:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Read(*)",
      "Write(Daily Notes/**)",
      "Write(Goals/**)",
      "Write(Projects/**)",
      "Write(Archives/**)",
      "Write(Templates/**)",
      "Write(Inbox/**)",
      "Edit(Daily Notes/**)",
      "Edit(Goals/**)",
      "Edit(Projects/**)",
      "Edit(Templates/**)",
      "Write(People/**)",
      "Edit(People/**)",
      "Write(Decisions/**)",
      "Edit(Decisions/**)",
      "Write(Finances/**)",
      "Edit(Finances/**)",
      "Edit(Inbox/**)",
      "Edit(Archives/**)",
      "Write(Companies/**)",
      "Edit(Companies/**)",
      "Write(Places/**)",
      "Edit(Places/**)",
      "Write(Tools/**)",
      "Edit(Tools/**)",
      "Write(Timeline/**)",
      "Edit(Timeline/**)",
      "Write(Areas/**)",
      "Edit(Areas/**)",
      "Write(Bases/**)",
      "Edit(Bases/**)",
      "Bash(python3 .claude/scripts/brain-lint.py:*)"
    ],
    "deny": [
      "Edit(.claude/**)",
      "Write(.git/**)",
      "Edit(.git/**)",
      "Bash(rm -rf:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  },
  "env": {
    "DAILY_NOTES_DIR": "Daily Notes",
    "GOALS_DIR": "Goals",
    "PROJECTS_DIR": "Projects",
    "TEMPLATES_DIR": "Templates",
    "ARCHIVES_DIR": "Archives",
    "GIT_AUTO_COMMIT": "true"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-init.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-commit.sh"
          }
        ]
      }
    ]
  }
}
